{
  "name": "echo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Echo (הד) - The Learning Memory of Human Judgment",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=@echo/shared run build",
    "build:backend": "npm --workspace=@echo/backend run build",
    "test:backend": "npm --workspace=@echo/backend test",
    "test:e2e": "npx tsx packages/e2e-tests/run-all-e2e.ts",
    "sync-decisions": "node scripts/sync-decisions.js",
    "test": "npm run build:shared && npm run build:backend && npm run test:backend && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
