rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only the authenticated owner can read/write their own recordings
    match /recordings/{userId}/{caseId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
