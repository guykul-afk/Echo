rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Decisions collection for global and user queries
    match /decisions/{decisionId} {
      allow read, write: if true;
    }

    // User-scoped decisions, sessions, and multi-tenancy
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Canonical Decision Cases, contracts, statements
    match /decision_cases/{caseId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
