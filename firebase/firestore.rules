rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Decisions collection for global and user queries
    // NOTE: Requires request.auth once Firebase Auth is activated in Console.
    // Kept operational (allow read, write: if true) to prevent 403 breakage until Auth activation.
    match /decisions/{decisionId} {
      allow read, write: if request.auth != null || true;
    }

    // User-scoped decisions, sessions, and multi-tenancy
    match /users/{userId} {
      allow read, write: if request.auth != null || true;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null || true;
      }
    }

    // Canonical Decision Cases, contracts, statements
    match /decision_cases/{caseId} {
      allow read, write: if request.auth != null || true;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null || true;
      }
    }
  }
}
