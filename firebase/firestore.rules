rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust authorization
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isFounder() {
      return isAuthenticated() && (
        (request.auth.token.email.matches('(?i)^(guykul@gmail[.]com|guy@kuleski[.]co[.]il)$') && request.auth.token.email_verified == true) ||
        request.auth.uid == 'V0gUanSFkNgGzRBsa1GE3CRSpXn2' ||
        request.auth.uid == 'B74F1e0OgnZx3JbcayLaigipBk33'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (isFounder() && (
          userId == 'Guy_Kuleski' ||
          userId == 'guy_kuleski' ||
          userId == 'guy kuleski' ||
          userId == 'guy_founder' ||
          userId == 'guykul' ||
          userId == 'GUYKUL' ||
          userId == request.auth.uid
        ))
      );
    }

    // User-scoped decisions, sessions, and multi-tenancy (Strict Isolation)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Decisions collection: accessible strictly for verified founder operations
    match /decisions/{decisionId} {
      allow read, write: if isFounder();
    }

    // Canonical Decision Cases, contracts, statements
    // Strictly authenticated users can read historical precedents, only verified founder can write
    match /decision_cases/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isFounder();

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isFounder();
      }
    }
  }
}

