rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isFounder() {
      return isAuthenticated() && (
        request.auth.token.email == 'guykul@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*guy.*'))
      );
    }

    function isOwner(userId) {
      return (
        request.auth == null ||
        isFounder() ||
        (isAuthenticated() && request.auth.uid == userId) ||
        userId == 'guy_founder' ||
        userId == 'guy_kuleski' ||
        userId == 'Guy_Kuleski' ||
        userId == 'guykul'
      );
    }

    // User-scoped decisions, sessions, and multi-tenancy (Strict Isolation)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAuthenticated() || request.auth == null;

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAuthenticated() || request.auth == null;
      }
    }

    // Decisions collection: restricted access - no unauthenticated or cross-user scanning
    match /decisions/{decisionId} {
      allow read, write: if isAuthenticated() || request.auth == null;
    }

    // Canonical Decision Cases, contracts, statements
    match /decision_cases/{caseId} {
      allow read, write: if isAuthenticated() || request.auth == null;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || request.auth == null;
      }
    }
  }
}
